# Softcenteric contact form email (copy to .env.local and fill in)

CONTACT_RECEIVER_EMAIL=info@softcenteric.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Neon Postgres — from https://console.neon.tech → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin JWT signing secret (1-day session). Change in production.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
